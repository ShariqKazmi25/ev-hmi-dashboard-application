# Copy this file to deploy/cluster-hmi.env on the Raspberry Pi and edit the values.

export CLUSTER_BATTERY_PORT=/dev/ttyUSB0
export CLUSTER_BATTERY_PROTOCOL=neuwat
export CLUSTER_BATTERY_BAUD=4800
export CLUSTER_BATTERY_SERIALS=17,22,6,26
export CLUSTER_BATTERY_TIMEOUT_S=0.2
export CLUSTER_BATTERY_POLL_TIMEOUT_S=2.0
export CLUSTER_BATTERY_RETRIES=3
export CLUSTER_BATTERY_POLL_INTERVAL_S=1.0

# Final vehicle data source #2: CAN controller link.
# On Raspberry Pi 4, the preferred setup is SocketCAN on can0.
export CLUSTER_CAN_ENABLED=1
export CLUSTER_CAN_INTERFACE=socketcan
export CLUSTER_CAN_CHANNEL=can0
export CLUSTER_CAN_BITRATE=250000
export CLUSTER_CAN_TIMEOUT_S=0.2
export CLUSTER_CAN_LISTEN_ONLY=1

# Tune this after the first road-speed comparison if needed.
export CLUSTER_CAN_SPEED_SCALE_KPH_PER_RPM=0.01257

# Range on the drive page is derived from battery SoC.
export CLUSTER_ESTIMATED_FULL_RANGE_KM=280

# Set this to 1 only if the controller current field is confirmed signed.
# export CLUSTER_CAN_CURRENT_SIGNED=0

# Legacy serial drive/inverter inputs are still supported when CAN is disabled.
# export CLUSTER_DRIVE_PORT=/dev/ttyUSB1
# export CLUSTER_DRIVE_BAUD=115200
# export CLUSTER_INVERTER_PORT=/dev/ttyUSB2
# export CLUSTER_INVERTER_BAUD=115200
